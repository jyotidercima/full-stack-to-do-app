<div class="content">
    <!-- Existing list form and items above -->

    <hr>
    <div class="add-list-section">
        <form action="/create-list" method="POST" class="create-list-form">
            <input type="text" name="newList" placeholder="Enter new list title..." autocomplete="off"
                class="new-list-input" />
            <button type="submit" class="new-list-btn">Add/Route list</button>
        </form>

        <div class="list-links">
            <h4>Available Lists:</h4>

            <ul class="list-collection">

                <li><a href="/" style="align-items: center;padding-right: 10px;">Today</a></li>
                <% if (typeof allLists !=='undefined' ) { %>
                    <% allLists.forEach(list=> { %>
                        <li class="list-show">
                            <div class="list-item" style="display: flex; align-items: center; gap: 8px;">
                                <a href="/<%= list.name %>">
                                    <%= list.name %>
                                </a>

                                <form class="list-show" action="/deleteList" method="POST" style="display: inline;">
                                    <input type="hidden" name="listName" value="<%= list.name %>">
                                    <button type="submit" class="delete-btn"
                                        onclick="return confirm('Are you sure you want to delete this list?')">🗑️</button>
                                </form>
                            </div>
                        </li>
                        <% }) %>
                            <% } %>

            </ul>
        </div>

    </div>
</div>